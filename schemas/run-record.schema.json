{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/grandjury/main/schemas/run-record.schema.json",
  "title": "Grandjury Campaign Run Record (v1)",
  "description": "Version 1 recorded-run and round-incident accounting record rebuilt by offline makers.",
  "type": "object",
  "required": [
    "questions",
    "seats_per_question_per_model",
    "models",
    "incident"
  ],
  "properties": {
    "questions": {
      "type": "integer",
      "minimum": 1
    },
    "seats_per_question_per_model": {
      "type": "integer",
      "minimum": 1
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "not": {
          "pattern": "[\\r\\n]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "route",
          "calls_attempted",
          "calls_recorded",
          "failed_calls",
          "abstained",
          "input_tokens",
          "output_tokens"
        ],
        "properties": {
          "route": {
            "type": "string",
            "enum": [
              "jev",
              "chat"
            ]
          },
          "calls_attempted": {
            "type": "integer",
            "minimum": 0
          },
          "calls_recorded": {
            "type": "integer",
            "minimum": 0
          },
          "failed_calls": {
            "type": "integer",
            "minimum": 0
          },
          "abstained": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cost_dollars": {
            "type": "string",
            "not": {
              "pattern": "[\\r\\n]"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "route": {
                  "const": "chat"
                }
              },
              "required": [
                "route"
              ]
            },
            "then": {
              "required": [
                "cost_dollars"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "route": {
                  "const": "jev"
                }
              },
              "required": [
                "route"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "cost_dollars"
                ]
              }
            }
          }
        ]
      }
    },
    "incident": {
      "type": "object",
      "required": [
        "lost_token_usage"
      ],
      "minProperties": 2,
      "properties": {
        "lost_token_usage": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "aborted_first_launch": {
          "type": "object"
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "calls_in_the_recorded_run",
          "attempts_that_never_left_the_machine",
          "envelopes_lost_and_seats_rerun",
          "calls_discarded",
          "route_verification_calls",
          "diagnostic_calls",
          "attempts_in_round"
        ],
        "properties": {
          "calls_in_the_recorded_run": {
            "type": "integer",
            "minimum": 0
          },
          "attempts_that_never_left_the_machine": {
            "type": "integer",
            "minimum": 0
          },
          "envelopes_lost_and_seats_rerun": {
            "type": "integer",
            "minimum": 0
          },
          "calls_discarded": {
            "type": "integer",
            "minimum": 0
          },
          "route_verification_calls": {
            "type": "integer",
            "minimum": 0
          },
          "diagnostic_calls": {
            "type": "integer",
            "minimum": 0
          },
          "verification_calls_in_the_aborted_first_launch": {
            "type": "integer",
            "minimum": 0
          },
          "attempts_in_round": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
