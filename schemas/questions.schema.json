{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/grandjury/main/schemas/questions.schema.json",
  "title": "Grandjury Campaign Questions (v1)",
  "description": "Version 1 ordered question list read by offline pilot, full, and wave makers.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "question",
      "answers"
    ],
    "properties": {
      "question": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]+$"
      },
      "answers": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        }
      }
    }
  }
}
